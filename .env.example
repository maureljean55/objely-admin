# Same Supabase project as the main Objely app — the admin portal reads/writes
# the same tables, but only ever through the service role key below.
NEXT_PUBLIC_SUPABASE_URL=https://nmjvehtzooqipvakntlo.supabase.co
SUPABASE_SECRET_KEY=

# Random 32+ byte secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# School database (Supabase project "objely-ecole"): where establishments and their sign-in accounts live.
# Used by the Organisation page. Service role key = Project Settings > API Keys > "secret". Server-only.
ECOLE_SUPABASE_URL=https://jmmqgvtucavtvxwukgpw.supabase.co
ECOLE_SUPABASE_SECRET_KEY=
# Where establishments sign in (shown next to the generated password). Optional.
ECOLE_ADMIN_URL=https://objely-ecole-admin.vercel.app
